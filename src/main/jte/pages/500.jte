@template.layout.default(
content = @`
    <div class="min-h-screen flex items-center justify-center bg-gray-100">
        <div class="max-w-md w-full p-8 bg-white rounded-lg shadow-md text-center">
            <div class="text-6xl mb-4">🔧</div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">500</h1>
            <p class="text-gray-600 mb-6">Server error occurred</p>
            <a href="/"
               class="inline-block px-6 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700">
                Go Home
            </a>
        </div>
    </div>
`)